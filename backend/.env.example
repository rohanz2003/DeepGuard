FIREBASE_PROJECT_ID=your-firebase-project-id
# Use a service-account file path in deployed environments. Never commit the file.
GOOGLE_APPLICATION_CREDENTIALS=C:\path\outside\workspace\firebase-service-account.json
# Local-only emulator mode. Set ENVIRONMENT=production to reject this setting.
USE_FIREBASE_EMULATORS=false
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Optional retained-audio storage. Leave MONGODB_URI empty unless users need
# retain_audio=true; ordinary uploads do not require MongoDB.
MONGODB_URI=mongodb+srv://user:password@example.mongodb.net/?retryWrites=true
MONGODB_DATABASE=deepguard
MONGODB_GRIDFS_BUCKET=audio
ENVIRONMENT=development
MAX_UPLOAD_BYTES=26214400
MAX_REQUEST_BYTES=27262976
MIN_DURATION_SECONDS=1
MAX_DURATION_SECONDS=300
RETENTION_DAYS=30
# Optional JSON model metadata. Empty means inference is unavailable.
MODEL_ARTIFACT_PATH=
MODEL_THRESHOLD=0.5
# Bounded in-process scan worker; queued jobs are lost if this process exits.
SCAN_MAX_WORKERS=2
SCAN_MAX_QUEUE=8
SCAN_MAX_ATTEMPTS=2
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=60
UPLOAD_RATE_LIMIT_PER_MINUTE=10
