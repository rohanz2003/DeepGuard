FIREBASE_PROJECT_ID=your-firebase-project-id
# Required for durable temporary raw-audio objects. Configure the bucket as
# private in Firebase/Google Cloud; this value is not a secret.
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# Use a service-account file path in deployed environments. Never commit the file.
GOOGLE_APPLICATION_CREDENTIALS=C:\path\outside\workspace\firebase-service-account.json
# Local-only emulator mode. Set ENVIRONMENT=production to reject this setting.
USE_FIREBASE_EMULATORS=false
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# STORAGE_EMULATOR_HOST=127.0.0.1:9199
ENVIRONMENT=development
MAX_UPLOAD_BYTES=26214400
MAX_REQUEST_BYTES=27262976
MIN_DURATION_SECONDS=1
MAX_DURATION_SECONDS=300
RETENTION_DAYS=30
# Temporary WAV object lifetime. Firestore metadata retention is independent.
SCAN_RAW_RETENTION_SECONDS=3600
SCAN_LEASE_SECONDS=300
SCAN_POLL_INTERVAL_SECONDS=5
SCAN_WORKER_COMMAND=python -m worker
# Optional JSON model metadata. Empty means inference is unavailable.
MODEL_ARTIFACT_PATH=
MODEL_THRESHOLD=0.5
# Kept for injected legacy test adapters; production processing is the durable
# Firestore queue consumed by the separate worker command above.
SCAN_MAX_WORKERS=2
SCAN_MAX_QUEUE=8
SCAN_MAX_ATTEMPTS=2
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=60
UPLOAD_RATE_LIMIT_PER_MINUTE=10
